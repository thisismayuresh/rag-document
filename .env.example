# Copy this to `.env` and adjust as needed. Every value here has a
# sensible default in config.py, so you only need to set what differs.

# --- Model providers ---
# The factories currently support "ollama". Add another provider adapter
# and register it in the factory when a different service is needed.
CHAT_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# "localhost" is correct if Ollama is a Docker container with its port
# published to the host (see docker-compose.yml) and this app runs on the
# host. If this app *itself* runs inside another container on the same
# Docker network as Ollama, use the service name instead, e.g.:
#   CHAT_SERVICE_URL=http://ollama:11434
#   EMBEDDING_SERVICE_URL=http://ollama:11434
CHAT_SERVICE_URL=http://localhost:11434
EMBEDDING_SERVICE_URL=http://localhost:11434
CHAT_MODEL_NAME=llama3.1:8b
EMBEDDING_MODEL_NAME=nomic-embed-text

# --- ChromaDB ---
# Same idea as above: "localhost" if Chroma's port is published to the
# host; the service name (e.g. "chromadb") if this app runs in a
# container on the same Docker network.
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=documents

# --- Chunking / retrieval ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RESULTS=4

# --- Networking / agent behaviour ---
# 0 means wait indefinitely for Ollama; use a positive value for a finite timeout.
REQUEST_TIMEOUT_SECONDS=0
MAX_TOOL_ROUNDS=4

# --- Sessions / uploads ---
# How many PDFs one chat session may hold (frontend and backend both enforce it).
MAX_DOCUMENTS_PER_SESSION=5
# Upload ceiling; larger files are rejected with a clear error.
MAX_UPLOAD_MB=2
# Where uploaded PDFs are archived on disk, one subfolder per session.
DOCUMENTS_DIR=documents

# --- API ---
# Browser origins allowed by CORS (comma-separated). The Vite dev server is
# the only intended consumer; it also proxies API calls, so this mainly
# matters if you serve the built frontend from another origin.
FRONTEND_ORIGINS=http://localhost:5173

# --- Logging ---
# Use DEBUG for Ollama request timings and detailed agent/tool flow.
LOG_LEVEL=INFO
